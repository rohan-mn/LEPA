# LEPA native Windows configuration
# Copy to .env. Never commit/share a real API key.

# AI routing switch:
#   openrouter-first = OpenRouter -> Ollama -> deterministic
#   ollama-first     = Ollama -> OpenRouter -> deterministic
AI_PROVIDER_PRIORITY=openrouter-first

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=LEPA

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

AI_SERVICE_URL=http://localhost:8000

# Empty dashboard is the default. Set true only if you explicitly want the old seeded journey.
LEPA_SEED_DEMO_JOURNEY=false

# Demo banking snapshot shown before a life-event document is uploaded.
LEPA_BANK_SAVINGS_BALANCE=980000
LEPA_BANK_SALARY_BALANCE=300000
LEPA_BANK_LOAN_OUTSTANDING=675000
LEPA_BANK_LOAN_EMI=22450
LEPA_BANK_MONTHLY_INCOME=200000
LEPA_BANK_AVERAGE_MONTHLY_SPEND=110000
LEPA_BANK_RESERVE_BUFFER=50000

# Optional PostgreSQL profile. Default runtime uses persistent embedded H2.
POSTGRES_DB=lepa
POSTGRES_USER=lepa
POSTGRES_PASSWORD=lepa123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LEPA_PORT=8080
